FoamFile
{
    format      ascii;
    class       dictionary;
    object      surfaces;
}

// 由 postProcess -func surfaces -latestTime 单独调用，隔离求解与采样失败
surfaces
{
    type            surfaces;
    libs            ("libsampling.so");
    writeControl    writeTime;
    writeInterval   1;
    surfaceFormat   vtk;
    fields          (p U);

    surfaces
    (
        car
        {
            type            sampledTriSurfaceMesh;
            surface         ${CAR_STL};
            source          triangulated;
        }
        slice
        {
            type            cuttingPlane;
            planeType       pointAndNormal;
            planePoint      ${SLICE_POINT};
            planeNormal     (0 1 0);
        }
    );
}
