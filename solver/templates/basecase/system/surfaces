FoamFile
{
    format      ascii;
    class       dictionary;
    object      surfaces;
}

// 由 postProcess -func surfaces -latestTime 单独调用，隔离求解与采样失败
surfaces
{
    type            surfaces;
    libs            ("libsampling.so");
    writeControl    writeTime;
    writeInterval   1;
    surfaceFormat   vtk;
    fields          (p U);

    surfaces
    (
        car
        {
            // patch 采样输出 snappy 表面网格顶点（数十万点，Cp 云图有分辨率）；
            // sampledTriSurfaceMesh 只输出 STL 原始顶点，云图过粗
            type            patch;
            patches         (car);
            interpolate     true;
        }
        slice
        {
            type            cuttingPlane;
            planeType       pointAndNormal;
            // v2312 要求 pointAndNormalDict 子字典（平铺 planePoint/planeNormal 是旧版）
            pointAndNormalDict
            {
                basePoint       ${SLICE_POINT};
                normalVector    (0 1 0);
            }
            interpolate      true;
        }
    );
}
