FoamFile
{
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

convertToMeters 1;

xmin ${XMIN};
xmax ${XMAX};
ymin ${YMIN};
ymax ${YMAX};
zmin ${ZMIN};
zmax ${ZMAX};

vertices
(
    ($xmin $ymin $zmin)
    ($xmax $ymin $zmin)
    ($xmax $ymax $zmin)
    ($xmin $ymax $zmin)
    ($xmin $ymin $zmax)
    ($xmax $ymin $zmax)
    ($xmax $ymax $zmax)
    ($xmin $ymax $zmax)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (${NX} ${NY} ${NZ}) simpleGrading (1 1 1)
);

edges ();

boundary
(
    inlet
    {
        type patch;
        faces ((0 4 7 3));
    }
    outlet
    {
        type patch;
        faces ((1 2 6 5));
    }
    sideL
    {
        type patch;
        faces ((0 1 5 4));
    }
    sideR
    {
        type patch;
        faces ((3 7 6 2));
    }
    ground
    {
        type wall;
        faces ((0 3 2 1));
    }
    top
    {
        type patch;
        faces ((4 5 6 7));
    }
);

mergePatchPairs ();
