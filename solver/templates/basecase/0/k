FoamFile
{
    format      ascii;
    class       volScalarField;
    object      k;
}

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform ${K_INF};

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform ${K_INF};
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform ${K_INF};
        value           uniform ${K_INF};
    }
    ground
    {
        type            slip;
    }
    top
    {
        type            zeroGradient;
    }
    sideL
    {
        type            zeroGradient;
    }
    sideR
    {
        type            zeroGradient;
    }
    car
    {
        type            kqRWallFunction;
        value           uniform ${K_INF};
    }
}
